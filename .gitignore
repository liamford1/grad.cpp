# Build directories
build*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
CTestTestfile.cmake
compile_commands.json

# Compiled objects and libraries
*.o
*.a

# Tooling caches
.cache/
.vscode/
.venv/
__pycache__/
*.py[cod]

# Model checkpoints and tokenizer caches (regenerated by training)
*.bin
*.cache
*.tok

# Per-run training metrics (regenerated; read by `grad watch`)
*_metrics.csv

# System files
.DS_Store

# Downloaded/derived corpora (only the small Shakespeare corpus is tracked)
data/tinystories*
data/ts_slice*

# Supervisor runtime state (train_supervised.sh): per-run log and single-instance lock
*_supervisor.log
.*.lock/
